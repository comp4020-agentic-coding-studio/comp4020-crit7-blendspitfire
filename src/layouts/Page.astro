---
import "../styles.css";

interface Props {
  title: string;
}
const { title } = Astro.props;
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
  </head>
  <body>
    <nav aria-label="site" class="site-nav">
      <span class="wordmark"><span class="wordmark-anu">ANU</span> Study Spaces</span>
      <a href="/">Find a spot</a>
      <a href="/readme/">About</a>
    </nav>
    <main>
      <slot />
    </main>
  </body>
</html>
