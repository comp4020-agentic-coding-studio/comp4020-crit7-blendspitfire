---
import { buildings } from "../data/buildings";
import Page from "../layouts/Page.astro";
import { ratingsByBuilding } from "../lib/db";
import { type AccessNow, windowAt } from "../lib/hours";
import { accessLabel, useLabel } from "../lib/labels";

const at = new Date();
const ratings = ratingsByBuilding();
const rank: Record<AccessNow, number> = { open: 0, card: 1, closed: 2 };

const rows = buildings
  .map((building) => {
    const window = windowAt(building, at);
    return {
      building,
      access: (window?.access ?? "closed") as AccessNow,
      unverified: window?.source === "invented",
      rating: ratings.get(building.number),
    };
  })
  .sort(
    (a, b) =>
      rank[a.access] - rank[b.access] ||
      (b.rating?.quietness ?? 0) - (a.rating?.quietness ?? 0) ||
      a.building.name.localeCompare(b.building.name),
  );

const useFilter = Astro.url.searchParams.get("use") ?? "";
const openOnly = Astro.url.searchParams.get("open") === "1";
const visibleRows = rows.filter(
  (r) => (!useFilter || r.building.use === useFilter) && (!openOnly || r.access === "open"),
);

const clock = new Intl.DateTimeFormat("en-AU", {
  timeZone: "Australia/Canberra",
  weekday: "long",
  hour: "numeric",
  minute: "2-digit",
}).format(at);
---

<Page title="Study spots at ANU">
  <h1>Where can I study right now?</h1>
  <p>
    It's {clock} in Canberra. Buildings you can walk into come first, then ones that
    need your ANU card, then the ones that are shut.
  </p>
  <form method="get" class="filters">
    <label>
      Type
      <select name="use">
        <option value="">All types</option>
        {Object.entries(useLabel).map(([use, label]) => (
          <option value={use} selected={useFilter === use}>
            {label}
          </option>
        ))}
      </select>
    </label>
    <label class="checkbox">
      <input type="checkbox" name="open" value="1" checked={openOnly} />
      Open right now only
    </label>
    <button>Apply</button>
  </form>
  {visibleRows.length === 0 && <p>No buildings match.</p>}
  <ul class="buildings">
    {
      visibleRows.map(({ building, access, unverified, rating }) => (
        <li>
          <a href={`/buildings/${building.number}/`}>{building.name}</a>
          <span class={`access access-${access}`}>
            {accessLabel[access]}
            {unverified && <span class="unverified">unverified</span>}
          </span>
          <p class="note">
            {useLabel[building.use]} · building {building.number}
            {rating &&
              ` · quiet ${rating.quietness.toFixed(1)}/5 · comfort ${rating.comfort.toFixed(1)}/5`}
          </p>
        </li>
      ))
    }
  </ul>
</Page>
